# Resend — API key para el envío de correos del formulario de /acerca.
# Consíguela en https://resend.com/api-keys y copia este archivo a .env.local
# (que está git-ignorado) con el valor real. NO pongas la clave real aquí.
RESEND_API_KEY=

# Supabase — URL del proyecto y clave publishable (sb_publishable_...).
# En el dashboard: Project Settings > API Keys. Copia este archivo a .env.local
# (git-ignorado) con los valores reales. La clave publishable no es secreta,
# pero se mantiene fuera del repo por coherencia con RESEND_API_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
